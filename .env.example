# AquaWise Environment Configuration Template
# Copy this file to .env and set your own secure secrets and keys

# Flask Secret Key for session signing
SECRET_KEY=

# Comma-separated exact browser origins allowed to use credentialed API requests.
# Leave unset in local development to use the localhost defaults in config.py.
CORS_ALLOWED_ORIGINS=

# Production cookie policy: Lax for same-site deployments; None for cross-site.
# Production requires an explicit choice. Secure cookies are always enabled there.
SESSION_COOKIE_SAMESITE=

# Database Connection URL (Defaults to local SQLite)
DATABASE_URL=sqlite:///database/aquawise.db

# Flask Application Environment (development, testing, production)
FLASK_ENV=development
DEBUG=True

# AI Configuration (Optional - application runs in offline rule-based fallback mode if not provided)
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=5000
